<div class="fuc-editor-body">
  <header class="fuc-editor-heading"><span>✦</span><div><h2>{{localize "FUC.EditorTitle"}}</h2><p>{{tokenName}}</p></div></header>
  {{#if prototype}}<p class="fuc-editor-note">{{localize "FUC.PrototypeHint"}}</p>{{/if}}
  <div class="fuc-editor-switches">
    <label><input type="checkbox" name="enabled" {{checked config.enabled}}> {{localize "FUC.Enabled"}}</label>
    <label><input type="checkbox" name="showHealth" {{checked config.showHealth}}> {{localize "FUC.ShowHealth"}}</label>
    <label><input type="checkbox" name="showEffects" {{checked config.showEffects}}> {{localize "FUC.ShowEffects"}}</label>
  </div>
  <div class="fuc-editor-grid">
    <label>{{localize "FUC.Name"}}<input type="text" name="name" value="{{config.name}}" placeholder="{{tokenName}}" maxlength="180"></label>
    <label>{{localize "FUC.Faction"}}<input type="text" name="faction" value="{{config.faction}}" maxlength="180"></label>
  </div>
  <label>{{localize "FUC.Description"}}<textarea name="description" rows="5" maxlength="12000">{{config.description}}</textarea></label>
  <label>{{localize "FUC.Specialty"}}<input type="text" name="specialty" value="{{config.specialty}}" maxlength="500"></label>
  <label>{{localize "FUC.Portrait"}}<span class="fuc-path-field"><input type="text" name="portrait" value="{{config.portrait}}"><button type="button" data-fuc-pick="portrait" aria-label="{{localize 'FUC.Browse'}}"><i class="fa-solid fa-file-image" aria-hidden="true"></i></button></span></label>
  <label>{{localize "FUC.Background"}}<span class="fuc-path-field"><input type="text" name="background" value="{{config.background}}"><button type="button" data-fuc-pick="background" aria-label="{{localize 'FUC.Browse'}}"><i class="fa-solid fa-file-image" aria-hidden="true"></i></button></span></label>
  <p class="fuc-editor-note">{{localize "FUC.ImageHint"}}</p>
  <fieldset class="fuc-appearance-config"><legend>{{localize "FUC.Appearance"}}</legend>
    <label>{{localize "FUC.ThemeLabel"}}<select name="theme">{{#each themeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
    <div class="fuc-theme-swatches" role="group" aria-label="{{localize 'FUC.ThemeLabel'}}">{{#each themeSwatches}}<button type="button" data-fuc-theme="{{value}}" aria-label="{{name}}" title="{{name}}" aria-pressed="{{#if selected}}true{{else}}false{{/if}}" style="--fuc-swatch:{{color}};--fuc-swatch-accent:{{accent}}"><span aria-hidden="true"></span>{{name}}</button>{{/each}}</div>
    <div class="fuc-editor-grid" data-fuc-custom-colors {{#unless customTheme}}hidden{{/unless}}>
      <label>{{localize "FUC.CardColor"}}<input type="color" name="cardColor" value="{{config.cardColor}}"></label>
      <label>{{localize "FUC.AccentColor"}}<input type="color" name="accentColor" value="{{config.accentColor}}"></label>
    </div>
    <div class="fuc-editor-grid">
      <label><span class="fuc-range-heading">{{localize "FUC.BackgroundOpacity"}}<output data-fuc-value-for="backgroundOpacity" data-unit="%">{{config.backgroundOpacity}}%</output></span><input type="range" name="backgroundOpacity" aria-label="{{localize 'FUC.BackgroundOpacity'}}" value="{{config.backgroundOpacity}}" min="0" max="100" step="1"></label>
      <label><span class="fuc-range-heading">{{localize "FUC.BackgroundDarkness"}}<output data-fuc-value-for="backgroundDarkness" data-unit="%">{{config.backgroundDarkness}}%</output></span><input type="range" name="backgroundDarkness" aria-label="{{localize 'FUC.BackgroundDarkness'}}" value="{{config.backgroundDarkness}}" min="0" max="100" step="1"></label>
      <label><span class="fuc-range-heading">{{localize "FUC.BackgroundBrightness"}}<output data-fuc-value-for="backgroundBrightness" data-unit="%">{{config.backgroundBrightness}}%</output></span><input type="range" name="backgroundBrightness" aria-label="{{localize 'FUC.BackgroundBrightness'}}" value="{{config.backgroundBrightness}}" min="20" max="180" step="1"></label>
      <label><span class="fuc-range-heading">{{localize "FUC.BackgroundBlur"}}<output data-fuc-value-for="backgroundBlur" data-unit=" px">{{config.backgroundBlur}} px</output></span><input type="range" name="backgroundBlur" aria-label="{{localize 'FUC.BackgroundBlur'}}" value="{{config.backgroundBlur}}" min="0" max="12" step="0.5"></label>
      <label>{{localize "FUC.BackgroundFit"}}<select name="backgroundFit">{{#each fitOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
      <label>{{localize "FUC.BackgroundPosition"}}<select name="backgroundPosition">{{#each positionOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
    </div>
    <p class="fuc-editor-note">{{localize "FUC.AppearanceHint"}}</p>
    <div class="fuc-appearance-actions"><button type="button" data-fuc-preview>{{localize "FUC.Preview"}}</button><button type="button" data-fuc-reset-appearance>{{localize "FUC.ResetAppearance"}}</button></div>
  </fieldset>
  <div class="fuc-editor-grid">
    <label>{{localize "FUC.Width"}}<input type="number" name="width" value="{{config.width}}" min="340" max="720" step="10"></label>
    <label>{{localize "FUC.VisibilityLabel"}}<select name="visibility">{{#each visibilityOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
  </div>
  <fieldset class="fuc-effect-config"><legend>{{localize "FUC.Effects"}}</legend><p class="fuc-editor-note">{{localize "FUC.EffectsHint"}}</p>
    {{#each effects}}<div class="fuc-effect-row {{#if disabled}}fuc-effect-disabled{{/if}}"><img src="{{img}}" alt=""><span>{{name}}<small>{{localize "FUC.Automatic"}}: {{automatic}}{{#if disabled}} · {{localize "FUC.Inactive"}}{{/if}}</small></span><select data-effect-key="{{key}}" aria-label="{{name}}">{{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
    {{else}}<p class="fuc-editor-note">{{localize "FUC.NoEffects"}}</p>{{/each}}
  </fieldset>
  <footer class="fuc-editor-footer"><button type="button" data-fuc-preview><i class="fa-solid fa-eye" aria-hidden="true"></i> {{localize "FUC.Preview"}}</button><button type="submit"><i class="fa-solid fa-floppy-disk" aria-hidden="true"></i> {{localize "FUC.Save"}}</button></footer>
</div>
